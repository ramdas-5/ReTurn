# ---------------------------------------------------------------------------
# ReTurn environment configuration (copy to .env for local development)
# Never commit real secrets. Values below are development-only.
# ---------------------------------------------------------------------------

# PostgreSQL (mandatory database). Alembic and Flask both read this.
DATABASE_URL=postgresql+psycopg://return:return_dev_pw@127.0.0.1:5433/return_dev
TEST_DATABASE_URL=postgresql+psycopg://return:return_dev_pw@127.0.0.1:5433/return_test

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=dev-only-change-me-4f8c1e6a9b2d4f70
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000
RATE_LIMIT_ENABLED=true
# Dev only: surfaces reset/activation tokens because email delivery is not
# configured. Set to false in production with a real email provider.
AUTH_EXPOSE_RESET_TOKENS=true
MAX_CONTENT_LENGTH_BYTES=12582912
# Trust one reverse-proxy hop (Render, Vercel, nginx). Keep false locally.
TRUST_PROXY_HEADERS=false

# First administrator (used only by `flask bootstrap-admin`; the command refuses
# to create a second administrator). Leave the password blank to generate one.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=ReTurn Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# Demo seeding is opt-in. The container entrypoint only seeds when the database
# has no users; SEED_DEMO_DATA_RESET=true makes every start destructive.
SEED_DEMO_DATA=false
SEED_DEMO_DATA_RESET=false

# Routing
# auto = try OSRM briefly, then fall back to a clearly labelled deterministic estimate
ROUTING_PROVIDER=auto
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=3

# Route-aware matching (rules-based, explainable; not machine learning)
MATCHING_MAX_DETOUR_KM=6
MATCHING_MAX_PICKUP_RADIUS_KM=5
MATCHING_MAX_WORKLOAD_PARCELS=12
MATCHING_MAX_WORKLOAD_WEIGHT_PCT=90
MATCHING_SERVICE_MINUTES=6
MATCHING_AVG_SPEED_KMH=24
MATCHING_ROAD_FACTOR=1.32
MATCHING_DEADLINE_BUFFER_MINUTES=10
MATCHING_SUGGESTION_TTL_MINUTES=45
MATCHING_MAX_SEARCH_DRIVERS=25

# Order intake
# One exterior parcel photograph is part of normal booking. The documented
# exception is a written reason (min characters) stored on the parcel.
PARCEL_PHOTO_REQUIRED=true
PARCEL_PHOTO_MIN_EXCEPTION_CHARS=12
# Reject orders whose pickup/delivery is outside every active service area.
REQUIRE_SERVICE_AREA_FOR_ORDERS=true
# A duty session without a heartbeat within this window is treated as stale.
DUTY_HEARTBEAT_TIMEOUT_MINUTES=15
MAX_PARCEL_IMAGES=5
DEFAULT_TIMEZONE=Asia/Kolkata

# Proof of pickup / delivery
PROOF_MAX_CAPTURE_AGE_MINUTES=20
PROOF_GPS_RADIUS_METERS=400
PROOF_MAX_ACCURACY_METERS=250
PROOF_REQUIRE_GPS=true
PICKUP_PROOF_REQUIRED=false
DELIVERY_PROOF_REQUIRED=true

# Media storage: local (dev fallback) or s3
MEDIA_BACKEND=local
# Defaults to backend/var/media; set an absolute path only when needed.
# MEDIA_LOCAL_DIR=/absolute/path/to/media
MEDIA_SIGNING_SECRET=dev-only-media-signing-secret
MEDIA_SIGNED_URL_TTL_SECONDS=300
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Estimated sustainability factors (modelled, not measured)
SUSTAINABILITY_FUEL_L_PER_KM=0.07
SUSTAINABILITY_KG_CO2E_PER_LITRE=2.68

# Next.js -> Flask proxy (server-only; never prefix with NEXT_PUBLIC_)
FLASK_API_URL=http://127.0.0.1:5000
# Server components call Flask directly with this URL
API_INTERNAL_URL=http://127.0.0.1:5000
