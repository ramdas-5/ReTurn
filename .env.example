# ---------------------------------------------------------------------------
# ReTurn environment configuration (copy to .env for local development)
# Never commit real secrets. Values below are development-only.
# ---------------------------------------------------------------------------

# PostgreSQL (mandatory database). Alembic and Flask both read this.
DATABASE_URL=postgresql+psycopg://return:return_dev_pw@127.0.0.1:5433/return_dev
TEST_DATABASE_URL=postgresql+psycopg://return:return_dev_pw@127.0.0.1:5433/return_test

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=dev-only-change-me-4f8c1e6a9b2d4f70
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true

# Routing
# auto = try OSRM briefly, then fall back to a clearly labelled deterministic estimate
ROUTING_PROVIDER=auto
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=3

# Matching configuration defaults (overridable per preview request)
MATCHING_MAX_GROUP_SIZE=3
MATCHING_MAX_PICKUP_RADIUS_KM=8
MATCHING_MAX_DETOUR_KM=12
MATCHING_MIN_SAVINGS_PCT=12
MATCHING_SERVICE_MINUTES=6
MATCHING_AVG_SPEED_KMH=24
MATCHING_ROAD_FACTOR=1.32

# Estimated sustainability factors (modelled, not measured)
SUSTAINABILITY_FUEL_L_PER_KM=0.07
SUSTAINABILITY_KG_CO2E_PER_LITRE=2.68

# Next.js -> Flask proxy (server-only; never prefix with NEXT_PUBLIC_)
FLASK_API_URL=http://127.0.0.1:5000
# Server components call Flask directly with this URL
API_INTERNAL_URL=http://127.0.0.1:5000
